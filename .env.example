# ============================================================================
#  Chinese Characters · HSK Levels — переменные окружения
#  Настоящих ключей в этом файле нет и быть не должно: он лежит в репозитории.
#  Значения задаются в Supabase → Project Settings → Edge Functions → Secrets.
# ============================================================================

# --- Публичное (можно писать во frontend, js/config.js) ----------------------
# anon key публичен по замыслу Supabase: доступ ограничивают политики RLS.
SUPABASE_URL=https://ваш-проект.supabase.co
SUPABASE_ANON_KEY=eyJ...публичный-anon-key...

# --- Секретное (только Edge Functions, во frontend не попадает) --------------
# Выдаётся Supabase автоматически внутри функций, вручную задавать не нужно:
# SUPABASE_SERVICE_ROLE_KEY=...

# Пароль администратора хранится только как хеш.
# Посчитать (подставьте свой пароль и свою соль):
#   printf '%s' "2007ваша-длинная-соль" | sha256sum
ADMIN_PIN_HASH=64-символьный-hex-хеш
ADMIN_PIN_SALT=любая-длинная-случайная-строка
ADMIN_SESSION_HOURS=4
ADMIN_MAX_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15

# Откуда разрешены запросы к функциям. Через запятую, без слеша на конце.
ALLOWED_ORIGINS=https://bayanbainyrasil-dotcom.github.io

# --- Озвучка ----------------------------------------------------------------
TTS_PROVIDER=azure
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_BUCKET=tts-audio

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# либо Google
GOOGLE_TTS_KEY=

# либо OpenAI
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
