{
  "name": "chinese-characters-hsk-levels",
  "version": "2.0.0",
  "private": true,
  "description": "Тренажёр китайских иероглифов HSK 3.0: письмо, озвучка, разбор слов и синхронизация прогресса",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/unit.test.mjs tests/e2e.test.mjs tests/audio.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test:audio": "node --test tests/audio.test.mjs",
    "lighthouse": "node tests/lighthouse.mjs && node tests/lighthouse.mjs --mobile",
    "serve": "python3 -m http.server 8000",
    "data": "python3 tools/build-data.py",
    "audio": "node tools/generate-audio.mjs --engine edge",
    "bump": "node tools/bump-version.mjs"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1"
  }
}
